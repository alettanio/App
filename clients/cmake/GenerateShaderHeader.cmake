# GenerateShaderHeader.cmake — zamienia binarny .spv na nagłówek C++ z tablicą uint32_t.
# Wymagane: -DINPUT=plik.spv -DOUTPUT=plik.h -DVARIABLE=nazwa_tablicy
file(READ "${INPUT}" hex HEX)
string(REGEX MATCHALL "[0-9a-f][0-9a-f]" bytes "${hex}")
list(LENGTH bytes nbytes)
set(words "")
set(i 0)
while(i LESS nbytes)
    # 4 bajty -> jeden uint32 (little-endian, jak w pliku SPIR-V)
    set(word "0x")
    set(j 3)
    while(j GREATER_EQUAL 0)
        math(EXPR idx "${i} + ${j}")
        if(idx LESS nbytes)
            list(GET bytes ${idx} b)
            string(APPEND word "${b}")
        else()
            string(APPEND word "00")
        endif()
        math(EXPR j "${j} - 1")
    endwhile()
    list(APPEND words "${word}")
    math(EXPR i "${i} + 4")
endwhile()
string(REPLACE ";" ",\n    " words_str "${words}")
set(content "#pragma once\n#include <cstdint>\nstatic const uint32_t ${VARIABLE}[] = {\n    ${words_str}\n};\n")
file(WRITE "${OUTPUT}" "${content}")
